{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/patyb7icloud/Auditoria-de-Governanca-de-Dados-Databricks/blob/main/docs/agent-intake.schema.json",
  "title": "Solicitação de Entrada de Agente de IA no Databricks",
  "description": "Schema inicial para validação de uma solicitação de governança de agente de IA.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requester",
    "agent",
    "governance",
    "costAttribution",
    "declaration"
  ],
  "properties": {
    "requester": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "email", "area"],
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 160 },
        "email": { "type": "string", "format": "email", "maxLength": 320 },
        "area": { "type": "string", "minLength": 2, "maxLength": 160 },
        "businessOwner": { "type": "string", "maxLength": 160 },
        "technicalOwner": { "type": "string", "maxLength": 160 },
        "plannedStartDate": { "type": "string", "format": "date" }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "purpose", "environment"],
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 160 },
        "agentId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
        },
        "purpose": { "type": "string", "minLength": 10, "maxLength": 2000 },
        "version": { "type": "string", "maxLength": 80 },
        "deploymentId": { "type": "string", "maxLength": 256 },
        "environment": {
          "type": "string",
          "enum": ["development", "homologation", "production"]
        },
        "databricksWorkspace": { "type": "string", "maxLength": 512 },
        "catalog": { "type": "string", "maxLength": 256 },
        "schemas": {
          "type": "array",
          "items": { "type": "string", "maxLength": 256 },
          "maxItems": 100
        },
        "objects": {
          "type": "array",
          "items": { "type": "string", "maxLength": 512 },
          "maxItems": 500
        },
        "models": {
          "type": "array",
          "items": { "type": "string", "maxLength": 512 },
          "maxItems": 100
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataCategories", "purpose", "productionData"],
      "properties": {
        "dataCategories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "public",
              "internal",
              "confidential",
              "personal",
              "sensitive_personal",
              "financial",
              "restricted",
              "unknown"
            ]
          }
        },
        "containsPersonalData": { "type": "boolean" },
        "containsSensitiveData": { "type": "boolean" },
        "purpose": { "type": "string", "minLength": 10, "maxLength": 2000 },
        "authorizedBasis": { "type": "string", "maxLength": 2000 },
        "retentionDays": { "type": "integer", "minimum": 0, "maximum": 36500 },
        "productionData": { "type": "boolean" },
        "expectedTags": {
          "type": "array",
          "items": { "type": "string", "maxLength": 160 },
          "maxItems": 100
        },
        "evidenceLinks": {
          "type": "array",
          "items": { "type": "string", "format": "uri", "maxLength": 2000 },
          "maxItems": 50
        }
      }
    },
    "costAttribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["costCenter", "project", "technicalKeys"],
      "properties": {
        "costCenter": { "type": "string", "minLength": 1, "maxLength": 160 },
        "project": { "type": "string", "minLength": 1, "maxLength": 160 },
        "financialOwner": { "type": "string", "maxLength": 160 },
        "technicalKeys": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "maxLength": 512 },
          "maxItems": 50
        },
        "allocationRule": { "type": "string", "maxLength": 1000 },
        "budgetReference": { "type": "string", "maxLength": 160 },
        "billingStartDate": { "type": "string", "format": "date" }
      }
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["informationIsAccurate", "ownerAcceptsFollowUp"],
      "properties": {
        "informationIsAccurate": { "const": true },
        "ownerAcceptsFollowUp": { "const": true },
        "submittedAt": { "type": "string", "format": "date-time" }
      }
    },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,160}$"
    }
  }
}
