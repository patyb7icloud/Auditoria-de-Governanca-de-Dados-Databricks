# Copie para n8n/.env e preencha apenas no host de execução. Nunca faça commit do .env.
# Pin a release aprovada da imagem do n8n; a versão sugerida é apenas base testada do projeto.
N8N_IMAGE_TAG=2.19.5
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PUBLIC_WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false

# Acesso ao workspace Databricks utilizado para disparar o job e consultar Delta.
# O host deve ser HTTPS, sem barra final. O Client ID/Secret ficam em Credential HTTP Basic Auth do n8n.
DATABRICKS_WORKSPACE_URL=https://<workspace-host>.azuredatabricks.net
DATABRICKS_JOB_ID=REPLACE_WITH_JOB_ID
DATABRICKS_SQL_WAREHOUSE_ID=REPLACE_WITH_SQL_WAREHOUSE_ID

# Identificadores Unity Catalog de três partes.
GOVERNANCE_REGISTRY_TABLE=governance.ai_inventory.ai_solution_registry
GOVERNANCE_MAPPING_TABLE=governance.ai_inventory.solution_mapping

# Webhook secreto do canal corporativo. O workflow suporta payloads Teams Adaptive Card ou Slack text.
GOVERNANCE_ALERT_CHANNEL=slack
GOVERNANCE_WEBHOOK_URL=https://<replace-with-incoming-webhook>

# O workflow lê variáveis $env para configuração e URL do webhook.
# Mantenha a instância n8n isolada e limite o acesso de edição a administradores.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
EXECUTIONS_TIMEOUT=1800
GENERIC_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo
