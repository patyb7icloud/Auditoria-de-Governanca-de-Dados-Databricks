      "id": "117742cb-0b41-4b89-b738-2117559aeeb4",
      "name": "Confirmar entrega do alerta",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        2610,
        20
      ]
    },
    {
      "parameters": {
        "jsCode": "const table = $env.GOVERNANCE_MAPPING_TABLE || 'governance.ai_inventory.solution_mapping';\nif (!/^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*){2}$/.test(table)) throw new Error('GOVERNANCE_MAPPING_TABLE deve ser catalog.schema.table.');\nconst esc = (value) => String(value ?? '').replace(/'/g, \"''\");\nconst r = $json;\nconst statement = `UPDATE ${table} SET notified_admin = TRUE, updated_by = 'n8n-governance-alert' WHERE agent_id = '${esc(r.agent_id)}' AND agent_type = '${esc(r.agent_type)}' AND workspace_id = '${esc(r.workspace_id)}'`;\nreturn [{ json: { request: { warehouse_id: $env.DATABRICKS_SQL_WAREHOUSE_ID, statement, wait_timeout: '30s', on_wait_timeout: 'CONTINUE', disposition: 'INLINE', format: 'JSON_ARRAY' } } }];"
      },
