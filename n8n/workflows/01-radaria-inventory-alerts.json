      "id": "b5e83d31-b849-4141-a218-282f2f396c48",
      "name": "Consultar findings no solution_mapping",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1450,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
