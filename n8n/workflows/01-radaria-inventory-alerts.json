    {
      "parameters": {
        "jsCode": "const body = $json;\nif (body.status?.state && body.status.state !== 'SUCCEEDED') throw new Error(`Consulta SQL não concluiu: ${body.status.state} ${body.status.error?.message || ''}`);\nconst columns = body.manifest?.schema?.columns?.map((c) => c.name) || [];\nconst rows = body.result?.data_array || [];\nif (!Array.isArray(rows)) throw new Error('Resposta SQL sem result.data_array.');\nif (!rows.length) return [{ json: { _noFindings: true } }];\nreturn rows.map((row) => {\n  const record = Object.fromEntries(columns.map((name, index) => [name, row[index]]));\n  let reasons = record.compliance_reasons || [];\n  if (typeof reasons === 'string') { try { reasons = JSON.parse(reasons); } catch { reasons = [reasons]; } }\n  if (!Array.isArray(reasons)) reasons = [];\n  return { json: { ...record, compliance_reasons: reasons, _noFindings: false } };\n});"
      },
      "id": "540f26cb-0357-4950-9336-e66c7083321f",
      "name": "Converter findings em itens n8n",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1690,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "has-findings",
              "leftValue": "={{ $json._noFindings !== true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "58e4b2ab-ce9b-4cb6-9b75-5a5e8b059a33",
      "name": "Há findings para alertar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1920,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst channel = ($env.GOVERNANCE_ALERT_CHANNEL || 'slack').toLowerCase();\nreturn items.map((item) => {\n  const r = item.json;\n  const title = r.compliance_status === 'NÃO_HOMOLOGADO'\n    ? 'ALERTA DE GOVERNANÇA DE IA - NOVO ATIVO / NÃO HOMOLOGADO'\n    : 'ALERTA DE GOVERNANÇA DE IA - DIVERGÊNCIA DE TAGS';\n  const reasons = Array.isArray(r.compliance_reasons)\n    ? r.compliance_reasons\n    : (r.compliance_reasons ? [String(r.compliance_reasons)] : []);\n  const lines = [\n    'Workspace: ' + (r.workspace_name || 'N/D') + ' (ID ' + (r.workspace_id || 'N/D') + ')',\n    'Ativo: ' + (r.agent_name || 'N/D') + ' (' + (r.agent_type || 'N/D') + ')',\n    'Agent ID: ' + (r.agent_id || 'N/D'),\n    'Status: ' + (r.compliance_status || 'NÃO_HOMOLOGADO'),\n    'Projeto: ' + (r.ai_project_id || 'N/D') + ' / ' + (r.ai_solution || 'N/D'),\n    'Motivo: ' + (reasons.length ? reasons.join('; ') : 'Não conformidade identificada no AI Registry.'),\n    'Ação necessária: regularizar a declaração/tags no AI Registry em até 5 dias; o gate de produção continuará bloqueando o ativo.'\n  ];\n  const text = lines.join('\\n');\n  let payload;\n  if (channel === 'teams') {\n    payload = {\n      type: 'message',\n      attachments: [{\n        contentType: 'application/vnd.microsoft.card.adaptive',\n        content: {\n          '$schema': 'http://adaptivecards.io/schemas/adaptive-card.json',\n          type: 'AdaptiveCard',\n          version: '1.4',\n          body: [\n            { type: 'TextBlock', text: title, weight: 'Bolder', size: 'Medium', wrap: true },\n            { type: 'TextBlock', text, wrap: true }\n          ]\n        }\n      }]\n    };\n  } else {\n    payload = { text: '*' + title + '*\\n' + text };\n  }\n  return { json: { ...r, payload } };\n});"
      },
