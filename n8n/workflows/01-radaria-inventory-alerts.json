      "parameters": {
        "jsCode": "const state = $json.state || {};\nconst pollCount = Number($json.poll_count || 0) + 1;\nconst terminalStates = new Set(['TERMINATED', 'SKIPPED', 'INTERNAL_ERROR']);\nreturn [{ json: { ...$json, poll_count: pollCount, job_succeeded: state.life_cycle_state === 'TERMINATED' && state.result_state === 'SUCCESS', is_terminal: terminalStates.has(state.life_cycle_state) } }];"
