    {
      "parameters": {
        "jsCode": "const state = $json.state || {};\nconst timedOut = Number($json.poll_count || 0) >= 90;\nconst title = timedOut ? 'ALERTA OPERACIONAL - TIMEOUT DO JOB RADARIA' : 'ALERTA OPERACIONAL - FALHA NO JOB RADARIA';\nconst details = timedOut ? `Job ${$json.run_id || 'N/D'} não terminou após 15 minutos. Estado: ${state.life_cycle_state || 'N/D'}; resultado: ${state.result_state || 'N/D'}.` : `Job ${$json.run_id || 'N/D'} terminou sem sucesso. Estado: ${state.life_cycle_state || 'N/D'}; resultado: ${state.result_state || 'N/D'}; mensagem: ${state.state_message || 'N/D'}.`;\nconst channel = ($env.GOVERNANCE_ALERT_CHANNEL || 'slack').toLowerCase();\nconst payload = channel === 'teams' ? { type: 'message', attachments: [{ contentType: 'application/vnd.microsoft.card.adaptive', content: { '$schema': 'http://adaptivecards.io/schemas/adaptive-card.json', type: 'AdaptiveCard', version: '1.4', body: [{ type: 'TextBlock', text: title, weight: 'Bolder', wrap: true }, { type: 'TextBlock', text: details, wrap: true }] } }] } : { text: `*${title}*\\n${details}` };\nreturn [{ json: { payload } }];"
      },
