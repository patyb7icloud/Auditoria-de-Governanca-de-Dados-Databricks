    {
      "parameters": {
        "jsCode": "const workspaceUrl = $env.DATABRICKS_WORKSPACE_URL;\nconst warehouseId = $env.DATABRICKS_SQL_WAREHOUSE_ID;\nconst mappingTable = $env.GOVERNANCE_MAPPING_TABLE || 'governance.ai_inventory.solution_mapping';\nif (!workspaceUrl || !warehouseId) throw new Error('Defina DATABRICKS_WORKSPACE_URL e DATABRICKS_SQL_WAREHOUSE_ID.');\nif (!/^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*){2}$/.test(mappingTable)) throw new Error('GOVERNANCE_MAPPING_TABLE deve ser catalog.schema.table.');\nconst statement = `SELECT agent_id, agent_name, agent_type, workspace_id, workspace_name, ai_project_id, ai_solution, compliance_status, compliance_reasons, last_seen_at FROM ${mappingTable} WHERE COALESCE(notified_admin, FALSE) = FALSE AND COALESCE(compliance_status, 'NÃO_HOMOLOGADO') <> 'CONFORME' ORDER BY last_seen_at DESC LIMIT 1000`;\nreturn [{ json: { request: { warehouse_id: warehouseId, statement, wait_timeout: '30s', on_wait_timeout: 'CONTINUE', disposition: 'INLINE', format: 'JSON_ARRAY' } } }];"
      },
      "id": "465f04d2-4b1a-44f8-8e30-2b8c73cd85d3",
      "name": "Preparar consulta de findings pendentes",
